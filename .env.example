# Upstash Redis — obtain from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REDIS_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_TOKEN

# Optional: Shared secret to authenticate incoming Odoo webhooks (recommended in production)
WEBHOOK_SECRET=your_optional_webhook_secret_here

# ABA PayWay Credentials (If KHQR is generated via Vercel Backend)
ABA_PAYWAY_MERCHANT_ID=your_merchant_id
ABA_PAYWAY_PUBLIC_KEY=your_public_key
ABA_PAYWAY_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ABA_PAYWAY_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ABA_PAYWAY_API_URL=https://checkout.payway.com.kh/api/payment-gateway/v1/payments/purchase

