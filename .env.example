# Upstash Redis — obtain from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REDIS_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_TOKEN

# Optional: Shared secret to authenticate incoming Odoo webhooks (recommended in production)
WEBHOOK_SECRET=your_optional_webhook_secret_here
